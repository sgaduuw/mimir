# Drop-in Caddy site for mimir. Adjust the hostname; HTTPS certs
# are managed automatically.
#
# `reverse_proxy` already forwards Host, X-Forwarded-For, and
# X-Forwarded-Proto by default, the latter is what gates mimir's
# HSTS header.

mimir.example.com {
    reverse_proxy 127.0.0.1:5000

    # Compress text content (Atom feeds, sitemap, search results).
    encode gzip zstd

    # Optional: rate-limit the public read paths. Caddy 2.x doesn't
    # ship rate limiting in core; install
    # github.com/mholt/caddy-ratelimit via `xcaddy build` if you
    # want this enabled.
    #
    # The unauth body-render path (`/<inbox>/<YYYY>/<MM>/<id>`) is
    # the hot DoS surface: each request triggers a recursive CTE,
    # a dulwich blob fetch, a MIME parse, and a Pygments highlight.
    # A bot crawling crafted URLs can burn worker time at gunicorn
    # rate. The example below caps message-view + search + attachment
    # downloads at ~30 req/min per client IP, generous for a real
    # reader and tight enough to flatten a scraper.
    #
    # @msg_view path_regexp ^/[^/]+/[0-9]{4}/[0-9]{2}/[0-9]+
    # @search   path /*/search
    # @attach   path_regexp /attachment/[0-9]+
    # rate_limit {
    #     zone hot {
    #         match @msg_view @search @attach
    #         key {http.request.remote_ip}
    #         events 30
    #         window 1m
    #     }
    # }
}
