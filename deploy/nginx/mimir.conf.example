# Example nginx config for mimir behind nginx as a reverse proxy.
# Adjust hostnames + cert paths; leave the proxy_set_header lines
# alone, mimir reads X-Forwarded-Proto (gates HSTS) and
# X-Request-Id (correlates with the structured access log).

server {
    listen 80;
    listen [::]:80;
    server_name mimir.example.com;

    # Redirect everything to HTTPS. Comment out if you're terminating
    # TLS somewhere upstream.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mimir.example.com;

    # TLS, replace with real paths.
    ssl_certificate     /etc/letsencrypt/live/mimir.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mimir.example.com/privkey.pem;

    # Optional: rate-limit the public read paths. The unauth body
    # render (`/<inbox>/<YYYY>/<MM>/<id>`) is the hot DoS surface;
    # each request triggers a CTE + blob fetch + MIME parse +
    # Pygments highlight. A bot crawling crafted URLs can burn
    # worker time at gunicorn rate. Define the zone outside the
    # server block (see the commented `limit_req_zone` near the
    # top of nginx.conf) and apply per-location below.
    #
    # limit_req_zone $binary_remote_addr zone=mimir_hot:10m rate=30r/m;

    # gunicorn on 127.0.0.1:5000 by default (see deploy/systemd/mimir.service
    # or compose.yaml's host port).
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Pass the public host along so mimir's absolute URLs
        # (sitemap entries, og:url, JSON-LD, canonical) carry the
        # public hostname rather than whatever Host the upstream is
        # configured with. Honoured when TRUSTED_PROXY_HOPS > 0.
        proxy_set_header X-Forwarded-Host  $host;
        # Mint a request id if the client didn't supply one; mimir
        # echoes it back in the response.
        proxy_set_header X-Request-Id      $request_id;

        proxy_read_timeout 30s;
    }

    # Rate-limit just the hot body-render paths. Uncomment together
    # with the `limit_req_zone` above to enable.
    #
    # location ~ ^/[^/]+/[0-9]{4}/[0-9]{2}/[0-9]+ {
    #     limit_req zone=mimir_hot burst=10 nodelay;
    #     proxy_pass http://127.0.0.1:5000;
    #     proxy_set_header Host              $host;
    #     proxy_set_header X-Real-IP         $remote_addr;
    #     proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    #     proxy_set_header X-Forwarded-Host  $host;
    #     proxy_set_header X-Request-Id      $request_id;
    # }

    # Compress text content. Atom and sitemap are XML; the search
    # results page can also get large.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/xml
        application/xml
        application/atom+xml
        application/json
        image/svg+xml;
}
