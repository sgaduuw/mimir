[Unit]
Description=mimir public-inbox archive
Documentation=https://github.com/sgaduuw/mimir
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mimir
Group=mimir
WorkingDirectory=/opt/mimir
EnvironmentFile=/opt/mimir/.env

# Bring schema up to head before serving. Idempotent on a current DB.
ExecStartPre=/opt/mimir/.venv/bin/alembic upgrade head
# Seed env-configured inboxes (mirrors what the compose deployment
# does on the scheduler sidecar). Without this a fresh systemd
# deploy comes up with an empty `inboxes` table and `/` renders a
# blank meta-index. Idempotent via ON CONFLICT DO NOTHING; admin
# edits to existing rows are never clobbered.
ExecStartPre=/opt/mimir/.venv/bin/mimir bootstrap-inboxes

# Two workers is plenty for a single-host SQLite archive; raise via
# the environment file if you actually saturate them.
# `--access-logfile` is deliberately omitted: the app emits its own
# JSON access-log line per request via `mimir.web.hooks._log_request`.
# Gunicorn's stock Apache-style line would duplicate every request.
ExecStart=/opt/mimir/.venv/bin/gunicorn 'mimir:create_app()' \
    --bind 127.0.0.1:5000 \
    --workers 2 \
    --error-logfile -

Restart=on-failure
RestartSec=5s

# Resource ceilings: bound a leaking worker / runaway parser from
# eating the host. MemoryHigh is the soft pressure (kernel throttles
# allocations); LimitNOFILE caps the gunicorn / dulwich open-file
# count at ~4k, comfortable for 2 workers + ad-hoc mirror walks.
MemoryHigh=2G
LimitNOFILE=4096

# Hardening, mimir reads from public-inbox mirrors and writes to a
# single SQLite file; everything else is off-limits.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ReadWritePaths=/opt/mimir

[Install]
WantedBy=multi-user.target
